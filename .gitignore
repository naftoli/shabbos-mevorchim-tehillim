# line lacks the "ANONYMIZED DEMO DATA" marker. A REAL roster regenerated by
# the converter lands at the ignored src/data/roster.generated.js — never
# import it from src/ and never `git add -f` it.
*soldiers*.html
*soldiers*.zip
